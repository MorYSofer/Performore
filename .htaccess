Options -MultiViews
RewriteEngine On

# Redirect legacy .html URLs to their clean canonical equivalents.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Remove an accidental trailing slash from clean page URLs.
RewriteRule ^(growth-strategy|algorithm-training|creative-strategy|media-buying|privacy-policy|cookie-policy)/$ /$1 [R=301,L]

# Internally serve the existing static HTML files at extensionless URLs.
RewriteRule ^(growth-strategy|algorithm-training|creative-strategy|media-buying|privacy-policy|cookie-policy)$ $1.html [L]
